// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           BigInt                     @id @default(autoincrement())
  uid                          String                     @unique
  extId                        String?                    @unique @map("ext_id") // For SSO integration
  email                        String                     @unique
  name                         String
  isBanned                     Boolean                    @default(false) @map("is_banned")
  isSystemAdmin                Boolean                    @default(false) @map("is_system_admin") // System-level admin flag
  profileUrl                   String?                    @map("profile_url")
  metadata                     Json                       @default("{}")
  creator                      Creator? // Optional creator profile linkage
  studioMemberships            StudioMembership[]
  studioShifts                 StudioShift[]
  schedules                    Schedule[]                 @relation("ScheduleCreator")
  publishedSchedules           Schedule[]                 @relation("SchedulePublisher")
  scheduleSnapshots            ScheduleSnapshot[]
  assignedTasks                Task[]
  createdTaskReportDefinitions TaskReportDefinition[]     @relation("TaskReportDefinitionCreatedBy")
  createdCompensationLineItems CompensationLineItem[]     @relation("CompensationLineItemCreatedBy")
  audits                       Audit[]
  publishRuns                  PublishRun[]               @relation("PublishRunTrigger")
  sceneQcReviews               SceneQcReview[]
  sceneQcDailyConfirmations    SceneQcDailyConfirmation[]
  createdAt                    DateTime                   @default(now()) @map("created_at")
  updatedAt                    DateTime                   @updatedAt @map("updated_at")
  deletedAt                    DateTime?                  @map("deleted_at")

  @@index([uid])
  @@index([email])
  @@index([name])
  @@index([extId])
  @@index([isBanned])
  @@index([isSystemAdmin])
  @@index([deletedAt])
  @@map("users")
}

model Creator {
  id                    BigInt          @id @default(autoincrement())
  uid                   String          @unique
  name                  String
  aliasName             String          @map("alias_name")
  isBanned              Boolean         @default(false) @map("is_banned")
  // Base fixed amount used by FIXED and HYBRID compensation.
  defaultRate           Decimal?        @map("default_rate") @db.Decimal(10, 2)
  // Compensation type options: FIXED | COMMISSION | HYBRID.
  defaultRateType       String?         @map("default_rate_type")
  // Commission percent (0-100) used by COMMISSION and HYBRID compensation.
  defaultCommissionRate Decimal?        @map("default_commission_rate") @db.Decimal(10, 2)
  type                  CreatorType     @default(STANDARD)
  metadata              Json            @default("{}")
  showCreators          ShowCreator[]
  studioCreators        StudioCreator[]
  userId                BigInt?         @unique @map("user_id")
  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")

  @@index([uid])
  @@index([userId])
  @@index([name])
  @@index([aliasName])
  @@index([isBanned])
  @@index([deletedAt])
  @@map("creators")
}

model Client {
  id                       BigInt                         @id @default(autoincrement())
  uid                      String                         @unique
  name                     String                         @unique
  contactPerson            String                         @map("contact_person")
  contactEmail             String                         @map("contact_email")
  metadata                 Json                           @default("{}")
  shows                    Show[]
  schedules                Schedule[]
  mechanics                ClientMechanic[]
  taskTemplates            TaskTemplate[]
  sceneProfiles            SceneProfile[]
  sceneQcConfirmationItems SceneQcDailyConfirmationItem[]
  createdAt                DateTime                       @default(now()) @map("created_at")
  updatedAt                DateTime                       @updatedAt @map("updated_at")
  deletedAt                DateTime?                      @map("deleted_at")

  @@index([uid])
  @@index([name])
  @@index([contactPerson])
  @@index([contactEmail])
  @@index([deletedAt])
  @@map("clients")
}

// Client-owned reusable moderation instruction (product / promotion cue).
// Single mutable row per mechanic — assigned into task-template loops by
// reference. Editing the moderator-facing instruction bumps `contentRevision`
// (frozen into template snapshots for staleness comparison); `version` is the
// optimistic-lock token. `status` (active|retired) is a reversible lifecycle,
// distinct from soft-delete (`deletedAt`).
model ClientMechanic {
  id               BigInt                    @id @default(autoincrement())
  uid              String                    @unique
  clientId         BigInt                    @map("client_id")
  client           Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title            String
  instructionLabel String                    @map("instruction_label")
  instructionBody  String                    @map("instruction_body")
  status           String                    @default("active") // active | retired
  version          Int                       @default(1)
  contentRevision  Int                       @default(1) @map("content_revision")
  metadata         Json                      @default("{}")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  deletedAt        DateTime?                 @map("deleted_at")
  templateRefs     TaskTemplateMechanicRef[]

  // uid is already indexed by @unique; clientId/status are served by the
  // composite indexes below — no standalone duplicates needed.
  // Actor history is tracked via the Audit model (AuditTarget), not a denormalized FK.
  @@index([deletedAt])
  @@index([clientId, deletedAt])
  @@index([clientId, status, deletedAt])
  @@map("client_mechanics")
}

model Platform {
  id                               BigInt                                 @id @default(autoincrement())
  uid                              String                                 @unique
  name                             String
  apiConfig                        Json                                   @map("api_config")
  metadata                         Json                                   @default("{}")
  showPlatforms                    ShowPlatform[]
  sceneQcConfirmationItemPlatforms SceneQcDailyConfirmationItemPlatform[]
  createdAt                        DateTime                               @default(now()) @map("created_at")
  updatedAt                        DateTime                               @updatedAt @map("updated_at")
  deletedAt                        DateTime?                              @map("deleted_at")

  @@index([uid])
  @@index([name])
  @@index([deletedAt])
  @@map("platforms")
}

model Show {
  id                          BigInt                         @id @default(autoincrement())
  uid                         String                         @unique
  externalId                  String?                        @map("external_id")
  name                        String
  startTime                   DateTime                       @map("start_time")
  endTime                     DateTime                       @map("end_time")
  actualStartTime             DateTime?                      @map("actual_start_time")
  actualEndTime               DateTime?                      @map("actual_end_time")
  metadata                    Json                           @default("{}")
  clientId                    BigInt                         @map("client_id")
  client                      Client                         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  studioId                    BigInt?                        @map("studio_id")
  studio                      Studio?                        @relation(fields: [studioId], references: [id], onDelete: SetNull)
  studioRoomId                BigInt?                        @map("studio_room_id")
  studioRoom                  StudioRoom?                    @relation(fields: [studioRoomId], references: [id], onDelete: SetNull)
  showTypeId                  BigInt                         @map("show_type_id")
  showType                    ShowType                       @relation(fields: [showTypeId], references: [id])
  showStatusId                BigInt                         @map("show_status_id")
  showStatus                  ShowStatus                     @relation(fields: [showStatusId], references: [id])
  showStandardId              BigInt                         @map("show_standard_id")
  showStandard                ShowStandard                   @relation(fields: [showStandardId], references: [id])
  scheduleId                  BigInt?                        @map("schedule_id")
  Schedule                    Schedule?                      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  showCreators                ShowCreator[]
  showPlatforms               ShowPlatform[]
  taskTargets                 TaskTarget[]
  compensationLineItemTargets CompensationLineItemTarget[]
  auditTargets                AuditTarget[]
  sceneQcReviews              SceneQcReview[]
  sceneQcConfirmationItems    SceneQcDailyConfirmationItem[]
  createdAt                   DateTime                       @default(now()) @map("created_at")
  updatedAt                   DateTime                       @updatedAt @map("updated_at")
  deletedAt                   DateTime?                      @map("deleted_at")

  @@unique([clientId, externalId])
  @@index([uid])
  @@index([name])
  @@index([clientId])
  @@index([studioId])
  @@index([studioRoomId])
  @@index([showTypeId])
  @@index([showStatusId])
  @@index([showStandardId])
  @@index([scheduleId])
  @@index([startTime, endTime])
  @@index([actualStartTime, actualEndTime])
  @@index([startTime])
  @@index([endTime])
  @@index([deletedAt])
  @@index([clientId, deletedAt])
  @@index([studioId, deletedAt])
  @@index([studioRoomId, deletedAt])
  @@index([scheduleId, deletedAt])
  @@index([showStatusId, deletedAt])
  @@index([startTime, deletedAt])
  @@index([clientId, startTime])
  @@index([clientId, startTime, deletedAt])
  @@index([clientId, showStatusId, deletedAt])
  @@index([clientId, showStatusId, startTime, deletedAt])
  @@index([studioRoomId, startTime, endTime, deletedAt]) // Room conflict detection
  @@index([scheduleId, startTime, deletedAt]) // Publishing workflow queries
  @@index([clientId, startTime, endTime, deletedAt]) // MC double-booking detection
  @@map("shows")
}

model ShowCreator {
  id                          BigInt                       @id @default(autoincrement())
  uid                         String                       @unique
  note                        String?
  // Per-show fixed amount override for FIXED and HYBRID compensation.
  agreedRate                  Decimal?                     @map("agreed_rate") @db.Decimal(10, 2)
  // Per-show compensation type override: FIXED | COMMISSION | HYBRID.
  compensationType            String?                      @map("compensation_type")
  // Per-show commission percent (0-100) override for COMMISSION and HYBRID.
  commissionRate              Decimal?                     @map("commission_rate") @db.Decimal(10, 2)
  actualStartTime             DateTime?                    @map("actual_start_time")
  actualEndTime               DateTime?                    @map("actual_end_time")
  attendanceMissing           Boolean                      @default(false) @map("attendance_missing")
  attendanceReason            String?                      @map("attendance_reason") // Required when derived attendance is LATE or attendanceMissing is true.
  metadata                    Json                         @default("{}")
  showId                      BigInt                       @map("show_id")
  show                        Show                         @relation(fields: [showId], references: [id], onDelete: Cascade)
  creatorId                   BigInt                       @map("mc_id")
  creator                     Creator                      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  compensationLineItemTargets CompensationLineItemTarget[]
  auditTargets                AuditTarget[]
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  deletedAt                   DateTime?                    @map("deleted_at")

  @@unique([showId, creatorId])
  @@index([uid])
  @@index([showId])
  @@index([creatorId])
  @@index([actualStartTime])
  @@index([attendanceMissing])
  @@index([actualStartTime, actualEndTime])
  @@index([deletedAt])
  @@index([showId, deletedAt])
  @@index([creatorId, deletedAt])
  @@index([creatorId, showId, deletedAt]) // MC double-booking queries
  @@map("show_creators")
}

model ShowPlatform {
  id              BigInt                  @id @default(autoincrement())
  uid             String                  @unique
  liveStreamLink  String?                 @map("live_stream_link") // external link of the live stream e.g., tiktok
  platformShowId  String?                 @map("platform_show_id") // external id of the platform e.g., tiktok
  actualStartTime DateTime?               @map("actual_start_time")
  actualEndTime   DateTime?               @map("actual_end_time")
  viewerCount     Int                     @default(0) @map("viewer_count")
  gmv             Decimal?                @map("gmv") @db.Decimal(12, 2)
  ctr             Decimal?                @map("ctr") @db.Decimal(5, 2)
  cto             Decimal?                @map("cto") @db.Decimal(5, 2)
  metadata        Json                    @default("{}")
  showId          BigInt                  @map("show_id")
  show            Show                    @relation(fields: [showId], references: [id], onDelete: Cascade)
  platformId      BigInt                  @map("platform_id")
  platform        Platform                @relation(fields: [platformId], references: [id], onDelete: Cascade)
  auditTargets    AuditTarget[]
  violations      ShowPlatformViolation[]
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  deletedAt       DateTime?               @map("deleted_at")

  @@unique([showId, platformId])
  @@index([uid])
  @@index([showId])
  @@index([platformId])
  @@index([platformShowId])
  @@index([actualStartTime, actualEndTime])
  @@index([deletedAt])
  @@index([showId, deletedAt])
  @@index([platformId, deletedAt])
  @@map("show_platforms")
}

model Studio {
  id                        BigInt                     @id @default(autoincrement())
  uid                       String                     @unique
  name                      String                     @unique
  address                   String
  metadata                  Json                       @default("{}")
  shows                     Show[]
  schedules                 Schedule[]
  studioRooms               StudioRoom[]
  studioMemberships         StudioMembership[]
  studioCreators            StudioCreator[]
  taskTemplates             TaskTemplate[]
  taskReportDefinitions     TaskReportDefinition[]
  tasks                     Task[]
  taskTargets               TaskTarget[]
  studioShifts              StudioShift[]
  compensationLineItems     CompensationLineItem[]
  publishRuns               PublishRun[]
  sceneQcDailyConfirmations SceneQcDailyConfirmation[]
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  deletedAt                 DateTime?                  @map("deleted_at")

  @@index([uid])
  @@index([name])
  @@index([deletedAt])
  @@map("studios")
}

model StudioCreator {
  id                    BigInt    @id @default(autoincrement())
  uid                   String    @unique
  studioId              BigInt    @map("studio_id")
  studio                Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  creatorId             BigInt    @map("mc_id")
  creator               Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  defaultRate           Decimal?  @map("default_rate") @db.Decimal(10, 2)
  defaultRateType       String?   @map("default_rate_type")
  defaultCommissionRate Decimal?  @map("default_commission_rate") @db.Decimal(10, 2)
  isActive              Boolean   @default(true) @map("is_active")
  version               Int       @default(1)
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@unique([studioId, creatorId])
  @@index([studioId, deletedAt])
  @@index([creatorId, deletedAt])
  @@map("studio_creators")
}

model StudioRoom {
  id        BigInt    @id @default(autoincrement())
  uid       String    @unique
  name      String
  capacity  Int?
  metadata  Json      @default("{}")
  studioId  BigInt    @map("studio_id")
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  shows     Show[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([studioId, name])
  @@index([uid])
  @@index([studioId])
  @@index([name])
  @@index([studioId, name])
  @@index([deletedAt])
  @@index([studioId, deletedAt])
  @@map("studio_rooms")
}

model ShowType {
  id        BigInt    @id @default(autoincrement())
  uid       String    @unique
  name      String    @unique // bau, campaign, other
  metadata  Json      @default("{}")
  shows     Show[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([uid])
  @@index([deletedAt])
  @@map("show_types")
}

model ShowStatus {
  id        BigInt    @id @default(autoincrement())
  uid       String    @unique
  systemKey String?   @unique @map("system_key")
  name      String    @unique // draft, confirmed, live, completed, cancelled, cancelled_pending_resolution
  metadata  Json      @default("{}")
  shows     Show[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([uid])
  @@index([deletedAt])
  @@map("show_status")
}

model ShowStandard {
  id        BigInt    @id @default(autoincrement())
  uid       String    @unique
  name      String    @unique // standard, premium
  metadata  Json      @default("{}")
  shows     Show[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([uid])
  @@index([deletedAt])
  @@map("show_standards")
}

model StudioMembership {
  id             BigInt    @id @default(autoincrement())
  uid            String    @unique
  role           String // admin, manager, member, talent_manager, designer, moderation_manager
  baseHourlyRate Decimal?  @map("base_hourly_rate") @db.Decimal(10, 2)
  metadata       Json      @default("{}")
  userId         BigInt    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studioId       BigInt    @map("studio_id")
  studio         Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([userId, studioId])
  @@index([uid])
  @@index([userId])
  @@index([studioId])
  @@index([role])
  @@index([userId, role])
  @@index([deletedAt])
  @@index([userId, deletedAt])
  @@index([studioId, deletedAt])
  @@index([userId, role, deletedAt]) // Authorization checks
  @@map("studio_memberships")
}

enum StudioShiftStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CompensationItemType {
  BONUS
  ALLOWANCE
  OVERTIME
  DEDUCTION
  OTHER
}

enum CompensationLineItemTargetType {
  SHOW
  SHOW_CREATOR
  STUDIO_SHIFT
  STUDIO_SHIFT_BLOCK
}

model StudioShift {
  id                          BigInt                       @id @default(autoincrement())
  uid                         String                       @unique
  studioId                    BigInt                       @map("studio_id")
  userId                      BigInt                       @map("user_id")
  date                        DateTime                     @db.Date
  hourlyRate                  Decimal                      @map("hourly_rate") @db.Decimal(10, 2)
  isApproved                  Boolean                      @default(false) @map("is_approved")
  isDutyManager               Boolean                      @default(false) @map("is_duty_manager")
  status                      StudioShiftStatus            @default(SCHEDULED)
  metadata                    Json                         @default("{}")
  blocks                      StudioShiftBlock[]
  compensationLineItemTargets CompensationLineItemTarget[]
  auditTargets                AuditTarget[]
  studio                      Studio                       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  deletedAt                   DateTime?                    @map("deleted_at")

  @@index([studioId, date])
  @@index([userId, date])
  @@index([studioId, isDutyManager, date])
  @@index([deletedAt])
  @@index([studioId, deletedAt])
  @@index([userId, deletedAt])
  @@map("studio_shifts")
}

model StudioShiftBlock {
  id                          BigInt                       @id @default(autoincrement())
  uid                         String                       @unique
  shiftId                     BigInt                       @map("shift_id")
  startTime                   DateTime                     @map("start_time")
  endTime                     DateTime                     @map("end_time")
  actualStartTime             DateTime?                    @map("actual_start_time")
  actualEndTime               DateTime?                    @map("actual_end_time")
  metadata                    Json                         @default("{}")
  shift                       StudioShift                  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  compensationLineItemTargets CompensationLineItemTarget[]
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  deletedAt                   DateTime?                    @map("deleted_at")

  @@index([shiftId])
  @@index([startTime, endTime])
  @@index([deletedAt])
  @@index([shiftId, deletedAt])
  @@map("studio_shift_blocks")
}

model CompensationLineItem {
  id          BigInt                      @id @default(autoincrement())
  uid         String                      @unique
  studioId    BigInt                      @map("studio_id")
  studio      Studio                      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  amount      Decimal                     @db.Decimal(12, 2)
  itemType    CompensationItemType        @map("item_type")
  reason      String
  createdById BigInt                      @map("created_by_id")
  createdBy   User                        @relation("CompensationLineItemCreatedBy", fields: [createdById], references: [id])
  metadata    Json                        @default("{}")
  // 1:1 polymorphic target. Optional in Prisma per 1:1 modeling rules; the application
  // creates a target alongside every line item in the same transaction.
  target      CompensationLineItemTarget?
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")
  deletedAt   DateTime?                   @map("deleted_at")

  @@index([uid])
  @@index([studioId, deletedAt])
  @@index([createdById])
  @@index([deletedAt])
  @@map("compensation_line_items")
}

// Polymorphism-only side table for CompensationLineItem (strict 1:1).
// `lineItemId` IS the row's identity — every line item has exactly one target, created in
// the same transaction. Lifecycle follows the parent (no own deletedAt; cascades on hard
// delete). Target entities (Show, ShowCreator, StudioShift, StudioShiftBlock) are
// removed via soft-delete in this codebase; the cascading typed FKs only fire on hard
// deletes, which would orphan the parent line item.
model CompensationLineItemTarget {
  lineItemId         BigInt                         @id @map("line_item_id")
  lineItem           CompensationLineItem           @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  targetType         CompensationLineItemTargetType @map("target_type")
  targetId           BigInt                         @map("target_id")
  showId             BigInt?                        @map("show_id")
  show               Show?                          @relation(fields: [showId], references: [id], onDelete: Cascade)
  showCreatorId      BigInt?                        @map("show_creator_id")
  showCreator        ShowCreator?                   @relation(fields: [showCreatorId], references: [id], onDelete: Cascade)
  studioShiftId      BigInt?                        @map("studio_shift_id")
  studioShift        StudioShift?                   @relation(fields: [studioShiftId], references: [id], onDelete: Cascade)
  studioShiftBlockId BigInt?                        @map("studio_shift_block_id")
  studioShiftBlock   StudioShiftBlock?              @relation(fields: [studioShiftBlockId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([showId])
  @@index([showCreatorId])
  @@index([studioShiftId])
  @@index([studioShiftBlockId])
  @@map("compensation_line_item_targets")
}

model Schedule {
  id              BigInt             @id @default(autoincrement())
  uid             String             @unique
  name            String // e.g., "January 2025 Planning"
  startDate       DateTime           @map("start_date")
  endDate         DateTime           @map("end_date")
  status          String             @default("draft") // draft, review, published
  publishedAt     DateTime?          @map("published_at")
  planDocument    Json               @default("{}") @map("plan_document")
  version         Int                @default(1)
  metadata        Json               @default("{}")
  clientId        BigInt?            @map("client_id")
  client          Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  studioId        BigInt?            @map("studio_id")
  studio          Studio?            @relation(fields: [studioId], references: [id], onDelete: SetNull)
  createdBy       BigInt?            @map("created_by")
  createdByUser   User?              @relation("ScheduleCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  publishedBy     BigInt?            @map("published_by")
  publishedByUser User?              @relation("SchedulePublisher", fields: [publishedBy], references: [id], onDelete: SetNull)
  shows           Show[] // Shows created from this schedule
  snapshots       ScheduleSnapshot[] // Version history
  publishRuns     PublishRun[]
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  @@index([uid])
  @@index([clientId])
  @@index([studioId])
  @@index([status])
  @@index([publishedAt])
  @@index([startDate, endDate])
  @@index([clientId, startDate])
  @@index([clientId, startDate, deletedAt])
  @@index([clientId, startDate, endDate])
  @@index([clientId, startDate, endDate, deletedAt])
  @@index([createdBy])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([clientId, deletedAt])
  @@index([studioId, deletedAt])
  @@index([clientId, status, deletedAt])
  @@index([clientId, status, startDate, deletedAt])
  @@index([createdBy, deletedAt])
  @@index([publishedBy, deletedAt])
  @@index([startDate, endDate, deletedAt]) // Monthly overview without client filter
  @@index([status, startDate, endDate, deletedAt]) // Status-filtered monthly overview
  @@index([publishedAt, deletedAt]) // Published date queries
  @@map("schedules")
}

// One row per schedule publish invocation. Append-only (no soft delete):
// like Audit, this is an audit-grade record — impact Audit rows reference it
// via Audit.publishRunId so a publish is a first-class, filterable batch unit.
model PublishRun {
  id            BigInt   @id @default(autoincrement())
  uid           String   @unique
  // Open, extensible trigger source: "google_sheets_sync" | "studio_native_snapshot".
  // String (not a Prisma enum) so adding a future trigger type is not a migration,
  // mirroring Schedule.status / Audit.action.
  source        String
  // Mirrors PublishScheduleSummary counts captured at the end of the publish call.
  summary       Json     @default("{}")
  scheduleId    BigInt   @map("schedule_id")
  schedule      Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  // Nullable to mirror Schedule.studioId — a schedule without a studio can still publish.
  studioId      BigInt?  @map("studio_id")
  studio        Studio?  @relation(fields: [studioId], references: [id], onDelete: SetNull)
  triggeredById BigInt?  @map("triggered_by_id")
  triggeredBy   User?    @relation("PublishRunTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)
  audits        Audit[]
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([studioId, createdAt])
  @@index([scheduleId])
  @@index([triggeredById])
  @@map("publish_runs")
}

// Immutable snapshot for version history
model ScheduleSnapshot {
  id             BigInt   @id @default(autoincrement())
  uid            String   @unique
  planDocument   Json     @map("plan_document")
  version        Int // Which version this snapshot represents
  status         String // Status at time of snapshot
  snapshotReason String   @map("snapshot_reason") // auto_save, before_publish, manual, before_restore
  metadata       Json     @default("{}")
  createdBy      BigInt?  @map("created_by")
  user           User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  scheduleId     BigInt   @map("schedule_id")
  schedule       Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([uid])
  @@index([scheduleId, version])
  @@index([scheduleId, createdAt])
  @@index([createdBy])
  @@index([createdBy, createdAt])
  @@index([scheduleId, snapshotReason, createdAt]) // Snapshot reason filtering
  @@map("schedule_snapshots")
}

// ============================================
// TASK TEMPLATES & SNAPSHOTS
// ============================================

model TaskTemplate {
  id                  BigInt                           @id @default(autoincrement())
  uid                 String                           @unique
  studioId            BigInt                           @map("studio_id")
  clientId            BigInt?                          @map("client_id")
  name                String
  description         String?
  isActive            Boolean                          @default(true) @map("is_active")
  // Current version (denormalized for convenience)
  currentSchema       Json                             @map("current_schema")
  version             Int                              @default(1)
  // Relations
  studio              Studio                           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client              Client?                          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  snapshots           TaskTemplateSnapshot[]
  tasks               Task[]
  mechanicRefs        TaskTemplateMechanicRef[]
  sceneQcEvidenceRefs TaskTemplateSceneQcEvidenceRef[]
  createdAt           DateTime                         @default(now()) @map("created_at")
  updatedAt           DateTime                         @updatedAt @map("updated_at")
  deletedAt           DateTime?                        @map("deleted_at")

  @@index([uid])
  @@index([studioId])
  @@index([clientId])
  @@index([isActive])
  @@index([studioId, updatedAt]) // Optimization for template listing
  @@map("task_templates")
}

model TaskTemplateSnapshot {
  id                  BigInt                           @id @default(autoincrement())
  templateId          BigInt                           @map("template_id")
  template            TaskTemplate                     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version             Int // 1, 2, 3, etc.
  schema              Json // Immutable schema at this version
  metadata            Json                             @default("{}") // Change notes, author, etc.
  tasks               Task[]
  mechanicRefs        TaskTemplateMechanicRef[]
  sceneQcEvidenceRefs TaskTemplateSceneQcEvidenceRef[]
  createdAt           DateTime                         @default(now()) @map("created_at")

  @@unique([templateId, version])
  @@index([templateId, version])
  @@map("task_template_snapshots")
}

model TaskTemplateMechanicRef {
  id         BigInt                @id @default(autoincrement())
  templateId BigInt                @map("template_id")
  template   TaskTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  snapshotId BigInt?               @map("snapshot_id")
  snapshot   TaskTemplateSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  mechanicId BigInt                @map("mechanic_id")
  mechanic   ClientMechanic        @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  group      String                @map("group")
  createdAt  DateTime              @default(now()) @map("created_at")

  @@index([templateId])
  @@index([snapshotId])
  @@index([mechanicId])
  @@map("task_template_mechanic_refs")
}

// Denormalized "which fields of this immutable snapshot are Scene QC evidence"
// projection. Mirrors TaskTemplateMechanicRef: written from the validated schema
// JSON on every Task Template create/publish (TaskTemplateRepository
// .syncSceneQcEvidenceRefsForTemplate), never the source of truth -- the JSON
// `items[].evidence_purpose` is. Holds no Scene QC FK at all, so it is Task
// Template's projection and Scene QC is a read-only consumer.
//
// snapshotId is REQUIRED (unlike TaskTemplateMechanicRef.snapshotId, which is
// nullable to carry a `currentSchema` draft row set). Plan section 5.2 specifies
// "Required immutable snapshot used by Tasks", and the resolver only ever joins
// through a Task's pinned snapshot -- a null-snapshot row would have no reader.
//
// The reviewed cutover backfill writes rows for HISTORICAL snapshots directly.
// Because the sync deletes only within one (templateId, snapshotId) scope, a
// later template edit can never wipe a backfilled historical binding.
model TaskTemplateSceneQcEvidenceRef {
  id         BigInt               @id @default(autoincrement())
  templateId BigInt               @map("template_id")
  template   TaskTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  snapshotId BigInt               @map("snapshot_id")
  snapshot   TaskTemplateSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  // Exact Task content key: v1 -> item.key, v2 -> item.id (getFieldContentKey).
  fieldKey   String               @map("field_key")
  // Snapshot-time display label. Never re-read from the live template.
  label      String               @map("label")
  createdAt  DateTime             @default(now()) @map("created_at")

  @@unique([snapshotId, fieldKey])
  @@index([templateId])
  @@index([snapshotId])
  @@map("task_template_scene_qc_evidence_refs")
}

model TaskReportDefinition {
  id          BigInt    @id @default(autoincrement())
  uid         String    @unique
  studioId    BigInt    @map("studio_id")
  studio      Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  name        String
  description String?
  definition  Json
  metadata    Json      @default("{}")
  version     Int       @default(1)
  createdById BigInt?   @map("created_by_id")
  createdBy   User?     @relation("TaskReportDefinitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([studioId, createdById, deletedAt, updatedAt])
  @@index([studioId, deletedAt, updatedAt])
  @@map("task_report_definitions")
}

// ============================================
// TASKS
// ============================================

enum TaskStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
  CLOSED
}

enum TaskType {
  SETUP // Pre-production
  ACTIVE // During show
  CLOSURE // Post-production
  ADMIN // Administrative
  ROUTINE // Regular maintenance
  OTHER
}

model Task {
  id                       BigInt                  @id @default(autoincrement())
  uid                      String                  @unique
  description              String
  status                   TaskStatus              @default(PENDING)
  type                     TaskType
  dueDate                  DateTime?               @map("due_date")
  completedAt              DateTime?               @map("completed_at")
  // Schema reference (immutable snapshot)
  snapshotId               BigInt?                 @map("snapshot_id")
  snapshot                 TaskTemplateSnapshot?   @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  // Optional template reference (for convenience queries)
  templateId               BigInt?                 @map("template_id")
  template                 TaskTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Form data (dynamic based on snapshot schema)
  content                  Json                    @default("{}")
  metadata                 Json                    @default("{}")
  // Optimistic locking
  version                  Int                     @default(1)
  // Scoping
  studioId                 BigInt?                 @map("studio_id")
  studio                   Studio?                 @relation(fields: [studioId], references: [id], onDelete: SetNull)
  // Assignment
  assigneeId               BigInt?                 @map("assignee_id")
  assignee                 User?                   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  // Associations
  targets                  TaskTarget[]
  sourcePlatformViolations ShowPlatformViolation[]
  sceneQcReviewEvidence    SceneQcReviewEvidence[]
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")
  deletedAt                DateTime?               @map("deleted_at")

  @@index([uid])
  @@index([snapshotId])
  @@index([templateId])
  @@index([templateId, deletedAt])
  @@index([studioId])
  @@index([assigneeId])
  @@index([status])
  @@index([deletedAt])
  @@index([assigneeId, status, deletedAt]) // My Tasks (base)
  @@index([assigneeId, status, dueDate]) // My Tasks (sorted by due date)
  @@index([studioId, status, deletedAt]) // Studio Dashboard
  @@index([studioId, assigneeId, deletedAt]) // Studio Assignment
  @@map("tasks")
}

// ============================================
// TASK TARGETS (POLYMORPHIC ASSOCIATION)
// ============================================

model TaskTarget {
  id         BigInt    @id @default(autoincrement())
  taskId     BigInt    @map("task_id")
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Generic polymorphic reference
  targetType String    @map("target_type") // "SHOW", "STUDIO", "PROJECT", etc.
  targetId   BigInt    @map("target_id")
  // Optional: Keep FK columns for referential integrity
  showId     BigInt?   @map("show_id")
  show       Show?     @relation(fields: [showId], references: [id], onDelete: Cascade)
  studioId   BigInt?   @map("studio_id")
  studio     Studio?   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  deletedAt  DateTime? @map("deleted_at")

  @@unique([taskId, targetType, targetId])
  @@index([taskId])
  @@index([showId])
  @@index([showId, deletedAt])
  @@index([studioId])
  @@index([studioId, deletedAt])
  @@index([targetType, targetId])
  @@index([deletedAt])
  @@map("task_targets")
}

// Append-only platform-violation log. Soft-history via `supersededAt`: a later
// extraction for the same `(sourceTaskId, sourceFieldId)` marks earlier rows
// superseded rather than deleting them. No `updatedAt` / `deletedAt` by design.
// See apps/erify_api/docs/TASK_INPUT_FACT_BINDING.md §2.A.
model ShowPlatformViolation {
  id             BigInt       @id @default(autoincrement())
  uid            String       @unique
  showPlatformId BigInt       @map("show_platform_id")
  showPlatform   ShowPlatform @relation(fields: [showPlatformId], references: [id], onDelete: Cascade)
  violationType  String       @map("violation_type")
  severity       String       @default("WARNING") @map("severity")
  reason         String       @map("reason")
  observedAt     DateTime     @map("observed_at")
  sourceTaskId   BigInt?      @map("source_task_id")
  sourceTask     Task?        @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  sourceFieldId  String?      @map("source_field_id")
  supersededAt   DateTime?    @map("superseded_at")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([showPlatformId])
  @@index([violationType])
  @@index([observedAt])
  @@index([sourceTaskId, sourceFieldId])
  @@index([showPlatformId, supersededAt])
  @@map("show_platform_violations")
}

// ============================================
// AUDIT (POLYMORPHIC HISTORY)
// ============================================
// Append-only history of automated extraction writes and manual manager overrides.
// Audit envelopes carry no FK to target entities, so deletes on target rows cascade
// only into the AuditTarget junction; the timeline itself is preserved. See
// apps/erify_api/docs/TASK_INPUT_FACT_BINDING.md §2.B.

model Audit {
  id             BigInt               @id @default(autoincrement())
  uid            String               @unique
  // "CREATE" | "UPDATE" | "DELETE" | "OVERRIDE" | "SKIPPED_LOWER_PRIORITY"
  action         String               @map("action")
  // Null for engine writes (extraction pipeline); populated for manager-initiated overrides.
  actorId        BigInt?              @map("actor_id")
  actor          User?                @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ipAddress      String?              @map("ip_address")
  userAgent      String?              @map("user_agent")
  // Free-text justification supplied by the actor on OVERRIDE-class writes.
  // Nullable because engine writes never carry a reason. Required-ness is
  // enforced per writer (see studio-shift hourly_rate, show-creator
  // compensation, etc.) — not at the schema level. Mirrors the legacy
  // `snapshot_overrides[].reason` shape so the sidecar merger maps 1:1.
  reason         String?              @map("reason")
  // Stores old/new values, ingestion_source, task_uid, task_field_id, etc.
  metadata       Json                 @default("{}")
  // Set on schedule_publish_impact rows written during a publish call; null for
  // all other audits and for impact rows that predate PublishRun (no backfill).
  publishRunId   BigInt?              @map("publish_run_id")
  publishRun     PublishRun?          @relation(fields: [publishRunId], references: [id], onDelete: SetNull)
  targets        AuditTarget[]
  sceneQcTargets SceneQcAuditTarget[]
  createdAt      DateTime             @default(now()) @map("created_at")

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@index([publishRunId])
  @@map("audits")
}

model AuditTarget {
  id             BigInt        @id @default(autoincrement())
  auditId        BigInt        @map("audit_id")
  audit          Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  // Polymorphic discriminator: "SHOW" | "SHOW_CREATOR" | "SHOW_PLATFORM" | "STUDIO_SHIFT"
  targetType     String        @map("target_type")
  targetId       BigInt        @map("target_id")
  // Typed nullable FKs. Cascade on target delete cleans up the junction without
  // touching the parent Audit envelope.
  showId         BigInt?       @map("show_id")
  show           Show?         @relation(fields: [showId], references: [id], onDelete: Cascade)
  showCreatorId  BigInt?       @map("show_creator_id")
  showCreator    ShowCreator?  @relation(fields: [showCreatorId], references: [id], onDelete: Cascade)
  showPlatformId BigInt?       @map("show_platform_id")
  showPlatform   ShowPlatform? @relation(fields: [showPlatformId], references: [id], onDelete: Cascade)
  studioShiftId  BigInt?       @map("studio_shift_id")
  studioShift    StudioShift?  @relation(fields: [studioShiftId], references: [id], onDelete: Cascade)

  @@unique([auditId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([showId])
  @@index([showCreatorId])
  @@index([showPlatformId])
  @@index([studioShiftId])
  @@map("audit_targets")
}

enum CreatorType {
  STANDARD
  FLEXIBLE
  OTHER
}

// ============================================
// SCENE QC
// ============================================
// Stage 1 Scene QC persistence. See
// apps/erify_api/docs/design/SCENE_QC_IMPLEMENTATION_PLAN.md sections 5.1 and 5.5.

enum SceneType {
  GRAPHIC_BG
  REAL_BACKDROP
}

// A Client's single mutable expected-scene reference image.
//
// At most one NON-DELETED row per Client. That rule is a DB-only PARTIAL unique
// index (`scene_profiles_active_client_key` on `client_id` WHERE
// `deleted_at IS NULL`) created in the `scene_qc_foundation` migration, because
// Prisma cannot express partial indexes. Do NOT add an unconditional
// `@@unique([clientId])` here — it would break retire-then-recreate.
//
// WARNING: because that index is invisible to Prisma, a later
// `prisma migrate dev` will try to emit
// `DROP INDEX "scene_profiles_active_client_key"`. Delete that statement from
// the generated migration if this ever runs again. An integration test asserts
// the index still exists.
//
// Lifecycle: retire IS soft delete (`deletedAt`). There is intentionally no
// reversible `status` column and no restore path — recreate is the way back.
// Replacing the image or scene type is a version-checked in-place update, never
// a revision row.
model SceneProfile {
  id           BigInt               @id @default(autoincrement())
  uid          String               @unique
  clientId     BigInt               @map("client_id")
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  objectKey    String               @map("object_key")
  fileUrl      String               @map("file_url")
  mimeType     String               @map("mime_type")
  fileSize     Int                  @map("file_size")
  sceneType    SceneType            @map("scene_type")
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  auditTargets SceneQcAuditTarget[]

  @@index([deletedAt])
  @@index([clientId, deletedAt])
  @@map("scene_profiles")
}

enum SceneQcResult {
  PASS
  MINOR
  FAIL
}

// The single current review head for a Show within one operational date. See
// SCENE_QC_IMPLEMENTATION_PLAN.md section 5.3 and
// SCENE_QC_CHILD_PR_3_BREAKDOWN.md section 1.1.2.
//
// No `deletedAt`: there is no public delete action for a review (plan section
// 7.8, "There is no public Delete review action"). Do not add a soft-delete
// column for symmetry with other Scene QC models.
//
// `@@unique([showId, operationalDate])` is the DB enforcement of "one review
// head per Show per operational date".
model SceneQcReview {
  id                            BigInt                         @id @default(autoincrement())
  uid                           String                         @unique
  showId                        BigInt                         @map("show_id")
  show                          Show                           @relation(fields: [showId], references: [id], onDelete: Cascade)
  // Date-only operational anchor, stored at UTC midnight. This IS the bucket
  // key (see operations-review-surface skill's date-only-column exception), so
  // `toISOString().slice(0, 10)` is the correct serializer here and only here.
  operationalDate               DateTime                       @map("operational_date") @db.Date
  windowStart                   DateTime                       @map("window_start")
  windowEnd                     DateTime                       @map("window_end")
  timezone                      String
  result                        SceneQcResult
  feedback                      String?
  reviewedById                  BigInt                         @map("reviewed_by_id")
  // `Restrict`, deliberately: a review must remain attributable. `User` is
  // soft-deleted in practice, so this is not an operational blocker. Contrast
  // `Audit.actor`, which is `SetNull` because engine writes have no actor.
  reviewedBy                    User                           @relation(fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt                    DateTime                       @map("reviewed_at")
  expectedObjectKey             String?                        @map("expected_object_key")
  expectedFileUrl               String?                        @map("expected_file_url")
  expectedSceneType             SceneType?                     @map("expected_scene_type")
  version                       Int                            @default(1)
  confirmedAt                   DateTime?                      @map("confirmed_at")
  createdAt                     DateTime                       @default(now()) @map("created_at")
  updatedAt                     DateTime                       @updatedAt @map("updated_at")
  evidence                      SceneQcReviewEvidence[]
  auditTargets                  SceneQcAuditTarget[]
  sceneQcDailyConfirmationItems SceneQcDailyConfirmationItem[]

  @@unique([showId, operationalDate])
  @@index([uid])
  @@index([operationalDate])
  @@index([showId])
  @@index([confirmedAt])
  @@map("scene_qc_reviews")
}

// Pins each image included in a Show review decision. See
// SCENE_QC_CHILD_PR_3_BREAKDOWN.md section 1.1.3 (OQ-1, OQ-4).
model SceneQcReviewEvidence {
  id                BigInt        @id @default(autoincrement())
  reviewId          BigInt        @map("review_id")
  review            SceneQcReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  sortOrder         Int           @map("sort_order")
  // Nullable + SetNull, plus a denormalized UID: ShowOrchestrationService hard-
  // deletes orphaned Tasks (show-orchestration.service.ts), and a required
  // cascading FK would silently erase a historical pinned-evidence row. See OQ-4.
  sourceTaskId      BigInt?       @map("source_task_id")
  sourceTask        Task?         @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  sourceTaskUid     String        @map("source_task_uid")
  sourceTaskVersion Int           @map("source_task_version")
  sourceFieldKey    String        @map("source_field_key")
  sourceLabel       String        @map("source_label")
  // Nullable: Task content stores only a public file_url string, not the
  // object key. `objectKey` is best-effort provenance derived by inverting
  // StorageService.resolvePublicFileUrl. See OQ-1 -- never reject evidence
  // solely for a non-derivable object key.
  objectKey         String?       @map("object_key")
  fileUrl           String        @map("file_url")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@unique([reviewId, sortOrder])
  @@index([reviewId])
  @@index([sourceTaskId])
  @@map("scene_qc_review_evidence")
}

// Capability-owned audit-target junction. Scene QC's target growth stays off the
// shared `audit_targets` table (see plan section 5.5). The target set is now
// complete for Stage 1 (Scene Profile, Scene QC review, Scene QC daily
// confirmation) -- any further typed FK must widen the
// `scene_qc_audit_targets_single_target_check` CHECK the same way, in its own
// migration, following this one's pattern.
//
// No `targetType` discriminator: the typed FK IS the discriminator, and the
// CHECK guarantees exactly one is set. Cascade runs from the target row into
// this junction only; the parent `Audit` envelope is preserved.
model SceneQcAuditTarget {
  id                         BigInt                    @id @default(autoincrement())
  auditId                    BigInt                    @map("audit_id")
  audit                      Audit                     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  sceneProfileId             BigInt?                   @map("scene_profile_id")
  sceneProfile               SceneProfile?             @relation(fields: [sceneProfileId], references: [id], onDelete: Cascade)
  sceneQcReviewId            BigInt?                   @map("scene_qc_review_id")
  sceneQcReview              SceneQcReview?            @relation(fields: [sceneQcReviewId], references: [id], onDelete: Cascade)
  sceneQcDailyConfirmationId BigInt?                   @map("scene_qc_daily_confirmation_id")
  sceneQcDailyConfirmation   SceneQcDailyConfirmation? @relation(fields: [sceneQcDailyConfirmationId], references: [id], onDelete: Cascade)

  // PostgreSQL does not automatically index the referencing side of a FK;
  // without this, loading an Audit's targets (history/detail paths) scans
  // this table.
  @@index([auditId])
  @@index([sceneProfileId])
  @@index([sceneQcReviewId])
  @@index([sceneQcDailyConfirmationId])
  @@map("scene_qc_audit_targets")
}

// Append-only daily confirmation. One row per (studio, operational date,
// revision). NEVER updated after insert -- a changed Show scope appends a new
// revision instead (plan section 5.4). There is deliberately no `updatedAt`,
// no `deletedAt`, and no `version`: an immutable historical artifact has no
// mutable state to lock. See SCENE_QC_CHILD_PR_4_BREAKDOWN.md section 1.1.1.
model SceneQcDailyConfirmation {
  id              BigInt                         @id @default(autoincrement())
  uid             String                         @unique
  studioId        BigInt                         @map("studio_id")
  studio          Studio                         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  // Same type as SceneQcReview.operationalDate (Child PR 3 OQ-5) -- UTC-midnight
  // date-only bucket key. The two MUST match or the join/compare breaks.
  operationalDate DateTime                       @map("operational_date") @db.Date
  windowStart     DateTime                       @map("window_start")
  windowEnd       DateTime                       @map("window_end")
  timezone        String
  revision        Int
  confirmedById   BigInt                         @map("confirmed_by_id")
  // Restrict, matching SceneQcReview.reviewedBy: a confirmation must remain
  // attributable. User is soft-deleted in practice.
  confirmedBy     User                           @relation(fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt     DateTime                       @map("confirmed_at")
  createdAt       DateTime                       @default(now()) @map("created_at")
  items           SceneQcDailyConfirmationItem[]
  auditTargets    SceneQcAuditTarget[]

  @@unique([studioId, operationalDate, revision])
  @@index([uid])
  @@index([studioId, operationalDate])
  @@map("scene_qc_daily_confirmations")
}

// One pinned Show per confirmation revision. Report identity, Show detail, and
// Client/platform breakdowns read THESE columns, never the current mutable Show
// / Client relations (plan section 5.4, section 6.3). The FKs below are
// provenance and join keys only.
model SceneQcDailyConfirmationItem {
  id                 BigInt                                 @id @default(autoincrement())
  confirmationId     BigInt                                 @map("confirmation_id")
  confirmation       SceneQcDailyConfirmation               @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  showId             BigInt                                 @map("show_id")
  show               Show                                   @relation(fields: [showId], references: [id], onDelete: Cascade)
  reviewId           BigInt                                 @map("review_id")
  review             SceneQcReview                          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  // Version of the effective review at confirmation time. Stage 2 amendment
  // detection compares this against the review's current version.
  reviewVersion      Int                                    @map("review_version")
  // Confirmation-time display facts. See OQ-27 for why the UIDs are
  // denormalized alongside the names the plan lists.
  showUid            String                                 @map("show_uid")
  showName           String                                 @map("show_name")
  scheduledStartTime DateTime                               @map("scheduled_start_time")
  clientId           BigInt                                 @map("client_id")
  client             Client                                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientUid          String                                 @map("client_uid")
  clientName         String                                 @map("client_name")
  createdAt          DateTime                               @default(now()) @map("created_at")
  platforms          SceneQcDailyConfirmationItemPlatform[]

  @@unique([confirmationId, showId])
  @@index([confirmationId])
  @@index([showId])
  @@index([reviewId])
  @@map("scene_qc_daily_confirmation_items")
}

// One normalized confirmation-time platform identity + label per item. A
// multi-platform Show contributes one row per linked platform, so platform
// breakdown totals are NOT expected to sum to the confirmed-Show total
// (plan section 6.3).
model SceneQcDailyConfirmationItemPlatform {
  id           BigInt                       @id @default(autoincrement())
  itemId       BigInt                       @map("item_id")
  item         SceneQcDailyConfirmationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // Platform is shared reference data; SetNull + denormalized uid/name so
  // deleting a Platform row never erases a historical report line.
  platformId   BigInt?                      @map("platform_id")
  platform     Platform?                    @relation(fields: [platformId], references: [id], onDelete: SetNull)
  platformUid  String                       @map("platform_uid")
  platformName String                       @map("platform_name")

  @@unique([itemId, platformUid])
  @@index([itemId])
  @@index([platformId])
  @@map("scene_qc_daily_confirmation_item_platforms")
}
