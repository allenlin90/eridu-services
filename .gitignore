# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
storybook-static
*.tsbuildinfo

# Paraglide generated files
**/paraglide/
**/src/paraglide/

# Inlang/Paraglide cache
**/project.inlang/cache/
**/.inlang/cache/


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

/db/
.worktrees/

# Claude Code harness runtime artifacts
.claude/scheduled_tasks.lock
.claude/worktrees/

# Per-developer Claude Code settings (opt-in hooks, personal permissions)
.claude/settings.local.json


# Superpowers brainstorming mockups (local-only)
.superpowers/

# Local code-graph index (derived, rebuild with Graphify)
graphify-out/

# Company wiki generated manifests (derived, regenerate via validate-wiki --write-manifest)
ai/openwebui/knowledge/company-wiki/generated/*

# creator-kb scraper session/state (auth_state.json is a live login session — never commit it)
scripts/ai/creator-kb/auth_state.json
scripts/ai/creator-kb/state.json
scripts/ai/creator-kb/scraped/

# Python bytecode (scripts/ai/* are run directly with python3)
__pycache__/
*.pyc
