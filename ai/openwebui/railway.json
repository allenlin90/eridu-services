{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "ai/openwebui/Dockerfile",
      "ai/openwebui/railway.json",
      "ai/openwebui/railway-entrypoint.sh",
      "ai/openwebui/push_config.py",
      "ai/openwebui/skills/**",
      "ai/openwebui/models/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "NEVER"
  }
}
